# ─── KnotNex Backend — Environment Configuration Template ────────────────────
# GCP Project: knotnex | Project ID: lively-welder-512304-n4
# Architecture: Cloud Run + Cloud SQL + Cloud Storage (low-cost 3-service)
# Region: asia-south1 (Mumbai)
# ────────────────────────────────────────────────────────────────────────────

# ─── Server & Environment Mode: 'development' | 'production' | 'test' ───
NODE_ENV=development
APP_ENV=development
PORT=8080
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,https://api.knotnex.com,https://knotnex.com,https://org.knotnex.com

# ─── PostgreSQL (Cloud SQL) ───
# For local dev: postgresql://knotnex_user:knotnex_password@localhost:5432/knotnex_db
# For production Cloud Run: postgresql://postgres:<password>@34.93.172.107:5432/knotnex_db
DATABASE_URL=postgresql://knotnex_user:knotnex_password@localhost:5432/knotnex_db
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_SSL=false
# AUTO_RUN_MIGRATIONS=true

# ─── Firebase ───
FIREBASE_PROJECT_ID=knotnex-f68fd
FIREBASE_SERVICE_ACCOUNT_KEY=./keys/knotnex-f68fd-firebase-adminsdk.json

# ─── GCP Cloud Storage ───
GCS_PROJECT_ID=lively-welder-512304-n4
GCS_MEDIA_BUCKET=knotnex-media-prod
GCS_PRIVATE_BUCKET=knotnex-private-prod

# ─── Email (Brevo / Sendinblue — 300 Free Emails/Day) ───
# REST API key (xkeysib-...) or SMTP key (xsmtpsib-...)
BREVO_API_KEY=xkeysib-your-api-key-here
BREVO_FROM_EMAIL=noreply@knotnex.com
BREVO_FROM_NAME=KnotNex Platform

# ─── SMS & Phone OTP (Postponed to Version 2) ───
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# TWILIO_PHONE_NUMBER=

# ─── Security ───
# JWT_SECRET: Used for access tokens (15min), refresh tokens (30d), registration tokens, reset tokens
# Use a strong random secret in production: openssl rand -base64 64
JWT_SECRET=knotnex_super_secret_jwt_key_2026_dev
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Logging ───
LOG_LEVEL=info
