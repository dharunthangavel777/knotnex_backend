# ─── Server & Environment Mode: 'development' | 'production' | 'test' ───
NODE_ENV=development
APP_ENV=development
PORT=8080
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,https://knotnex-backend-445162659573.europe-west1.run.app,https://api.knotnex.com

# ─── PostgreSQL (Cloud SQL) ───
DATABASE_URL=postgresql://knotnex_user:knotnex_password@localhost:5432/knotnex_db
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_SSL=false

# ─── Redis (Memorystore) ───
# Required for: OTP storage, JWT refresh token revocation, distributed rate limiting
REDIS_URL=redis://localhost:6379

# ─── Firebase ───
FIREBASE_PROJECT_ID=knotnex-dev
FIREBASE_SERVICE_ACCOUNT_KEY=./keys/firebase-sa.json

# ─── GCP Cloud Storage ───
GCS_MEDIA_BUCKET=knotnex-media-dev
GCS_PRIVATE_BUCKET=knotnex-private-dev
GCS_PROJECT_ID=knotnex-dev

# ─── Email (Brevo / Sendinblue — 300 Free Emails/Day) ───
# REST API key (xkeysib-...) or SMTP key (xsmtpsib-...)
BREVO_API_KEY=xkeysib-your-api-key-here
BREVO_FROM_EMAIL=noreply@knotnex.com
BREVO_FROM_NAME=KnotNex Platform

# ─── SMS & Phone OTP (Postponed to Version 2) ───
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# TWILIO_PHONE_NUMBER=

# ─── Pub/Sub ───
PUBSUB_PROJECT_ID=knotnex-dev

# ─── Security ───
# JWT_SECRET: Used for access tokens (15min), refresh tokens (30d), registration tokens, reset tokens
# Use a strong random secret in production: openssl rand -base64 64
JWT_SECRET=knotnex_super_secret_jwt_key_2026_dev
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Logging ───
LOG_LEVEL=info
